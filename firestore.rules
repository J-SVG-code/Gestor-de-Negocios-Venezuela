rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdminAccount() {
      return isSignedIn() && request.auth.uid == 'rhijOZhr1MSJYgNu73YxjiAZffL2';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc(uid) {
      return exists(userDocPath(uid));
    }

    function isAdmin() {
      return isOwnerAdminAccount() || (
        isSignedIn() && (
          request.auth.token.admin == true ||
          (hasUserDoc(request.auth.uid) && get(userDocPath(request.auth.uid)).data.role == 'admin')
        )
      );
    }

    function isMemberOfStoreData(data) {
      return isSignedIn() && (
        data.ownerUid == request.auth.uid ||
        (('memberUids' in data) && (request.auth.uid in data.memberUids))
      );
    }

    function isStoreSuspendedData(data) {
      return (
        (('suspended' in data) && data.suspended == true) ||
        (('inhabilitada' in data) && data.inhabilitada == true) ||
        (('activa' in data) && data.activa == false) ||
        (('status' in data) && (data.status == 'suspended' || data.status == 'disabled'))
      );
    }

    function billingFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status',
        'suspended',
        'inhabilitada',
        'activa',
        'paidUntil',
        'trialEndsAt',
        'proximoVencimiento',
        'lastPaymentRef',
        'lastPaymentDate',
        'lastPlanMonths',
        'suspensionReason',
        'exentoCobro',
        'nuncaSuspender'
      ]);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());

      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && (
          !('role' in request.resource.data) ||
          (('role' in resource.data) && request.resource.data.role == resource.data.role) ||
          request.resource.data.role in ['dueno', 'socio', 'encargado', 'empleado', 'cajero', 'vendedor', 'almacen', 'usuario']
        )
      );

      allow delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if isAdmin() || isMemberOfStoreData(resource.data);

      allow create: if isSignedIn()
        && (
          request.resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        )
        && (!('suspended' in request.resource.data) || request.resource.data.suspended == false || isAdmin())
        && (!('inhabilitada' in request.resource.data) || request.resource.data.inhabilitada == false || isAdmin());

      allow update: if isAdmin()
        || (
          isMemberOfStoreData(resource.data)
          && billingFieldsUnchanged()
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || (
          isSignedIn()
          && !isStoreSuspendedData(resource.data)
          && !isMemberOfStoreData(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'equipo', 'updatedAt'])
          && ('memberUids' in request.resource.data)
          && (request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size() <= 10
          && (!('equipo' in request.resource.data) || request.resource.data.equipo is list)
        );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /{subcol}/{docId} {
        allow read, write: if isAdmin()
          || (
            isMemberOfStoreData(get(/databases/$(database)/documents/stores/$(storeId)).data)
            && !isStoreSuspendedData(get(/databases/$(database)/documents/stores/$(storeId)).data)
          );
      }
    }

    match /payment_references/{refId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
      allow create, update, delete: if isAdmin();
    }

    match /subscription_requests/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /support_requests/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /system_clock/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
