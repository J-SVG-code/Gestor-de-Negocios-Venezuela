rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOfStore(storeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }

    function isMemberOfStore(storeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        request.auth.uid in get(/databases/$(database)/documents/stores/$(storeId)).data.memberUids;
    }

    function isStoreActiveAndNotSuspended(storeId) {
      let s = get(/databases/$(database)/documents/stores/$(storeId)).data;
      return s.suspended != true &&
        (
          s.status == 'trial' ||
          s.status == 'active' ||
          (s.paidUntil != null && request.time.toMillis() <= s.paidUntil) ||
          (s.trialEndsAt != null && request.time.toMillis() <= s.trialEndsAt)
        );
    }

    // Perfil de usuario: solo el propio usuario puede leer/escribir su documento
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Negocios / Tiendas: cada negocio tiene su propio ID y fecha de ingreso inmutable (createdAt)
    match /stores/{storeId} {
      // Cualquier usuario autenticado puede leer un negocio si necesita validar/unirse por QR,
      // o el dueño/miembro puede leerlo.
      allow read: if isSignedIn();

      // Crear negocio: debe asignar su uid como ownerUid, incluir ownerUid en memberUids,
      // fijar createdAt (fecha de ingreso) y no auto-activarse como pagado sin validación
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storeId == storeId
        && request.resource.data.createdAt is int
        && request.resource.data.trialEndsAt is int
        && request.auth.uid in request.resource.data.memberUids;

      // Actualizar negocio:
      // - El dueño puede actualizar su negocio, pero NO puede alterar la fecha de ingreso (createdAt)
      //   ni forzar status='active' / suspended=false sin control (se recomienda Cloud Function/Admin SDK para activar pagos).
      // - Un socio/encargado/empleado vinculado (memberUids) puede actualizar datos operativos si el negocio está activo/no suspendido.
      // - Un usuario autenticado nuevo puede agregarse a memberUids y team al vincularse mediante QR si el negocio no está suspendido.
      allow update: if isSignedIn() && (
        (
          resource.data.ownerUid == request.auth.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.suspended == resource.data.suspended
        )
        ||
        (
          isMemberOfStore(storeId) &&
          isStoreActiveAndNotSuspended(storeId) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.suspended == resource.data.suspended
        )
        ||
        (
          !(request.auth.uid in resource.data.memberUids) &&
          request.auth.uid in request.resource.data.memberUids &&
          resource.data.suspended != true &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.suspended == resource.data.suspended
        )
      );

      // Eliminación directa desde cliente bloqueada (usar borrado lógico o Admin SDK)
      allow delete: if false;
    }

    // Solicitudes de pago de suscripción enviadas por el dueño
    match /subscription_requests/{reqId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Sugerencias / solicitudes de eliminación de datos
    match /support_requests/{reqId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
